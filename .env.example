# Tariq.lb environment example.
# Copy to .env locally. Never commit real secrets.

APP_ENV=development
FLASK_ENV=development
SECRET_KEY=replace-with-a-strong-random-secret

DATABASE_URL=sqlite:///tariq.db
AUTO_CREATE_DATABASE=true

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-werkzeug-generated-password-hash

MODEL_PATH=models/road_damage_v3.pt
DETECTION_MODEL_PATH=models/road_damage_v3.pt
DETECTION_API_URL=internal
DETECTION_API_TOKEN=replace-with-random-internal-token
DETECTION_API_REQUIRE_TOKEN=false
DETECTION_PRELOAD_MODEL=false

UPLOAD_FOLDER=static/uploads
ANNOTATED_FOLDER=static/uploads/annotated
PERSISTENT_UPLOADS_CONFIRMED=false
MAX_CONTENT_LENGTH=5242880

SESSION_COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_COUNT=1
