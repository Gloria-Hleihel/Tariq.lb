# Tariq.lb production environment example.
# Copy to .env for local testing only. Do not commit real secret values.

APP_ENV=production
FLASK_ENV=production
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://user:password@host:5432/tariq
ADMIN_USERNAME=replace-admin-username
ADMIN_PASSWORD_HASH=replace-with-werkzeug-password-hash

# Uploads must point to durable storage in production.
UPLOAD_FOLDER=static/uploads
ANNOTATED_FOLDER=static/uploads/annotated
PERSISTENT_UPLOADS_CONFIRMED=false
ALLOW_EPHEMERAL_UPLOADS=false

# Model and detection runtime.
MODEL_PATH=models/road_damage_v3.pt
DETECTION_PRELOAD_MODEL=0
DETECTION_API_URL=internal
DETECTION_API_TIMEOUT=30

# HTTPS/proxy settings for managed hosts such as Render.
SESSION_COOKIE_SECURE=1
PREFERRED_URL_SCHEME=https
TRUST_PROXY_HEADERS=1

# Safety limits.
MAX_CONTENT_LENGTH=5242880
MAX_IMAGE_PIXELS=24000000
RATE_LIMIT_ENABLED=1
LOG_LEVEL=INFO
